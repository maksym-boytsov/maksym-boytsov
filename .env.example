# Copy to .env.local for local development. Never commit real values.

# Anthropic API key for the note writer (create one with a monthly spend limit).
ANTHROPIC_API_KEY=

# Optional. Daily spending cap for the note writer, in US dollars. Default: 3
CHAT_DAILY_BUDGET_USD=

# Resend, so "Send" can deliver messages to your inbox. Without it, the site falls back to a mailto link.
RESEND_API_KEY=
# Optional. Who the email is from (any address on the verified maksym.page domain). Default: "maksym.page <hello@maksym.page>"
RESEND_FROM=
# Optional. Where messages go. Default: maksym.boytsov@gmail.com
MESSAGE_TO=
